# RunPod Serverless worker for fibroblast segmentation.
#
# Pulls source directly from the public GitHub repo at build time.
# To update the image, rebuild (optionally pinning REPO_REF to a commit
# or tag) and push a new tag.
#
# Build (public repo, no auth required):
#   docker build \
#     --platform linux/amd64 \
#     -f Dockerfile.runpod \
#     -t <docker-user>/fibroblast-runpod:latest .
#
# Pin to a specific commit:
#   docker build \
#     --platform linux/amd64 \
#     --build-arg REPO_REF=<commit-sha> \
#     -f Dockerfile.runpod \
#     -t <docker-user>/fibroblast-runpod:<sha> .

FROM runpod/pytorch:1.0.2-cu1281-torch280-ubuntu2404

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    MPLBACKEND=Agg \
    CELLPOSE_LOCAL_MODELS_PATH=/runpod-volume/cellpose_models

# Override at build time with --build-arg REPO_URL=... / REPO_REF=...
ARG REPO_URL=https://github.com/finkbeiner-lab/Hevolution-Fibroblast-Detection.git
ARG REPO_REF=main

# System libs: git to clone, libgl/libglib for OpenCV + matplotlib runtime.
RUN apt-get update && apt-get install -y --no-install-recommends \
        git ca-certificates libglib2.0-0 libgl1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Clone, then check out whatever ref was asked for, then strip .git metadata.
#
# NOT `git clone --depth 1 --branch "$REPO_REF"`: that accepts only branch and
# tag NAMES. Passing a commit SHA fails the build outright with
#   fatal: Remote branch <sha> not found in upstream origin
# and a commit SHA is exactly what you want to pin a production image to.
# A full clone of this repo is under 1 MB, so there is nothing to save by
# being shallow. REPO_REF now takes a branch, a tag, or a commit SHA - the
# second checkout covers a bare branch name that needs the origin/ prefix.
RUN git clone --quiet "$REPO_URL" /app/repo \
    && ( git -C /app/repo checkout --detach "$REPO_REF" \
         || git -C /app/repo checkout --detach "origin/$REPO_REF" ) \
    && git -C /app/repo log --oneline -1 \
    && rm -rf /app/repo/.git \
    && ls /app/repo/runpod_handler.py /app/repo/requirements-runpod.txt

# Install Python deps from the cloned tree.
RUN pip install --no-cache-dir -r /app/repo/requirements-runpod.txt

# Cellpose weights live on the RunPod Network Volume mounted at
# /runpod-volume (see CELLPOSE_LOCAL_MODELS_PATH above). Pre-populate
# the volume once via a temporary Pod with these two files:
#   /runpod-volume/cellpose_models/cyto3           (~26 MB, main weights)
#   /runpod-volume/cellpose_models/size_cyto3.npy  (~3.6 KB, size model)
# Every serverless worker then reads from the volume instead of
# downloading on each cold start.

WORKDIR /app/repo

# RunPod Serverless entrypoint.
CMD ["python", "-u", "runpod_handler.py"]
